# Copy this file to .env and fill in your key. Never commit .env.

# Free key from https://console.groq.com
GROQ_API_KEY=

# Model that answers customer questions
GENERATOR_MODEL=openai/gpt-oss-20b

# Model that grades the answers (LLM-as-a-judge). A bigger model judges better.
JUDGE_MODEL=openai/gpt-oss-120b

# Which system prompt version the assistant uses (see src/bankrag/prompts.py)
PROMPT_VERSION=v2

# "sentence-transformers" (real semantic search) or "hash" (offline, for CI unit tests)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Number of chunks retrieved per question
TOP_K=4
